__pycache__/
*.py[cod]
.venv/
# One venv per machine type on the clusters' shared $HOME; see sphragis/experiment/cluster-env.sh.
.venv-*/
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
dist/
build/
*.egg-info/
.env

# Corpus text: everything under a corpus root is ignored except what results cite, so a stage
# added later is out of git without anyone listing it. Manifests and seals ARE committed.
datasets/gerrit*/**
!datasets/gerrit*/*/
!datasets/gerrit*/*/manifest.json
!datasets/gerrit*/*/seal.json
# Label-audit sheets and other working copies of corpus text.
scratch/
# Battery inputs are concatenated and deduplicated from those examples by
# scripts/contamination_windows.py, so they are derived twice over.
datasets/results/contamination-inputs/

COMMITS.md

# Slurm job output. The directory is tracked so a relative --output always resolves
# in a fresh clone: Slurm does not create it, and a job that cannot open its log dies
# at IO setup after the queue wait.
logs/*
!logs/.gitkeep

# The built docs site. `zensical build` writes it; the workflow publishes from the job.
site/

# Claude Code session worktrees
.claude/worktrees/
