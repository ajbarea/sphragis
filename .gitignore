__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
dist/
build/
*.egg-info/
.env

# Corpus artifacts: derived data is regenerated from the frozen raw snapshots,
# and raw snapshots are large. Manifests and seals ARE committed.
datasets/gerrit/*/raw/
datasets/gerrit/*/examples/
datasets/gerrit/*/splits/
!datasets/gerrit/*/manifest.json
!datasets/gerrit/*/seal.json

COMMITS.md

# Slurm job output. The directory is tracked so a relative --output always resolves
# in a fresh clone: Slurm does not create it, and a job that cannot open its log dies
# at IO setup after the queue wait.
logs/*
!logs/.gitkeep
