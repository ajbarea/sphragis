__pycache__/
*.py[cod]
.venv/
# One venv per machine type on the clusters' shared $HOME; see sphragis/experiment/cluster-env.sh.
.venv-*/
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
dist/
build/
*.whl
*.egg-info/
.env

# Corpus text: everything under a corpus root is ignored except what results cite, so a stage
# added later is out of git without anyone listing it. Manifests and seals ARE committed.
datasets/gerrit*/**
!datasets/gerrit*/*/
!datasets/gerrit*/*/manifest.json
!datasets/gerrit*/*/seal.json
# Label-audit sheets and other working copies of corpus text.
scratch/
# Battery inputs are concatenated and deduplicated from those examples by
# scripts/contamination_windows.py, so they are derived twice over.
datasets/results/contamination-inputs/
# Generation runs of a host opened by written grant: their predictions are model text that can
# repeat a reviewer's comment, which the grants exclude from anything published. Their likelihood
# rescorings, ids and scores only, are committed (research log, 2026-10-18). A name carries its
# org (`qtfull` for Qt's full pool) and any sidecar: rows, a job's temporary file, a part.
# rq1-pilot and rq1-windows always read Qt (scripts/rq1.sbatch); a foreign arm names its source.
# Left to the content check: projects-*, determinism-*, calibration-*, retrieval-foreign-<target>.
datasets/results/rq1-partition-qt*
datasets/results/rq1-partition-chromium*
datasets/results/rq1-partition-aosp*
datasets/results/rq1-partition-fuchsia*
datasets/results/rq1-placebo-qt*
datasets/results/rq1-placebo-chromium*
datasets/results/rq1-placebo-aosp*
datasets/results/rq1-placebo-fuchsia*
datasets/results/retrieval-halves-qt*
datasets/results/retrieval-halves-chromium*
datasets/results/retrieval-halves-aosp*
datasets/results/retrieval-halves-fuchsia*
datasets/results/rules-halves-qt*
datasets/results/rules-halves-chromium*
datasets/results/rules-halves-aosp*
datasets/results/rules-halves-fuchsia*
datasets/results/rules-reviews-qt*
datasets/results/rules-reviews-chromium*
datasets/results/rules-reviews-aosp*
datasets/results/rules-reviews-fuchsia*
datasets/results/retrieval-foreign-qt*
datasets/results/retrieval-foreign-chromium*
datasets/results/retrieval-foreign-aosp*
datasets/results/retrieval-foreign-fuchsia*
datasets/results/rules-foreign-qt*
datasets/results/rules-foreign-chromium*
datasets/results/rules-foreign-aosp*
datasets/results/rules-foreign-fuchsia*
datasets/results/*-foreignqt*
datasets/results/*-foreignchromium*
datasets/results/*-foreignaosp*
datasets/results/*-foreignfuchsia*
datasets/results/rq1-pilot*
datasets/results/rq1-windows*
*.partial

COMMITS.md

# Slurm job output. The directory is tracked so a relative --output always resolves
# in a fresh clone: Slurm does not create it, and a job that cannot open its log dies
# at IO setup after the queue wait.
logs/*
!logs/.gitkeep

# The built docs site. `zensical build` writes it; the workflow publishes from the job.
site/

# Claude Code session worktrees
.claude/worktrees/

# Generated from docs/research-log.md by scripts/log_to_blog.py
docs/log/
