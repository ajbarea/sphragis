# Salt for pseudonymising Gerrit account identities at ingestion.
# Generate once, keep it out of git, and do not distribute it: the salt is what
# makes the pseudonyms irreversible for anyone holding the corpus.
#
#   python -c "import secrets; print(secrets.token_hex(32))"
SPHRAGIS_CORPUS_SALT=

# Key for the digests that stand in for model text in published results
# (scripts/withhold_text.py). Generate once like the salt, keep it out of git, and
# keep it apart from the salt: a key used here is used for nothing else.
SPHRAGIS_PREDICTION_KEY=
